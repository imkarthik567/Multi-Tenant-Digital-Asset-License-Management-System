{
  "info": {
    "name": "AssetVault REST API Collection",
    "_postman_id": "c1f8a845-6677-4b45-927b-b5d19488a03d",
    "description": "Multi-Tenant Digital Asset & License Management System (BCSE307L Course Project). Covers all 16 domains, auth flows, seat allocations, checkout, CSV import/export, audit diff, and reporting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "assetId",
      "value": "",
      "type": "string"
    },
    {
      "key": "licenseId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Docs",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "OpenAPI Spec JSON",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/docs.json"
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Tenant Self-Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"DesignCraft Studios\",\n  \"slug\": \"designcraft\",\n  \"contactEmail\": \"admin@designcraft.internal\",\n  \"adminFullName\": \"Karthik Admin\",\n  \"adminEmail\": \"admin@designcraft.internal\",\n  \"password\": \"SecurePass123!#\"\n}"
            },
            "url": "{{baseUrl}}/auth/register-tenant"
          }
        },
        {
          "name": "Email & Password Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@designcraft.internal\",\n  \"password\": \"SecurePass123!#\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Logout Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
