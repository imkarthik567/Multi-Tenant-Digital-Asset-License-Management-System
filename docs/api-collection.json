              "raw": "{\n  \"name\": \"Helvetica Neue Pro Font Family\",\n  \"assetCode\": \"FNT-HLV-001\",\n  \"assetType\": \"FONT\",\n  \"description\": \"Corporate brand typeface OTF package\"\n}"
