            "url": "{{baseUrl}}/licenses/{{licenseId}}/release"
          }
        },
        {
          "name": "List License Seat Holders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/licenses/{{licenseId}}/allocations"
          }
