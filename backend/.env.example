# ==============================================================================
# AssetVault - API Environment Template (backend/.env.example)
# ==============================================================================

PORT=5000
NODE_ENV=development

# Runtime API URL uses the restricted app role; its password must match APP_DB_PASSWORD.
DATABASE_URL=postgresql://assetvault_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@localhost:5432/assetvault_db?schema=public
# Direct URL is used for migrations, bootstrap, seeding and trusted maintenance.
DIRECT_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@localhost:5432/assetvault_db
MIGRATE_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@localhost:5432/assetvault_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=assetvault_db
APP_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SEED_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@localhost:5432/assetvault_db
SUPER_ADMIN_EMAIL=superadmin@your-local-domain.test
SUPER_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_SUPER_ADMIN_PASSWORD
DEFAULT_SEED_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD

JWT_ACCESS_SECRET=placeholder_random_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=placeholder_random_jwt_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=placeholder_random_cookie_secret_min_32_characters
# Local dev only; hosted Vercel + Render should set COOKIE_SAMESITE=none over HTTPS.
COOKIE_SAMESITE=strict

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Metrics endpoint: optional in local development; required as a unique secret in production
# METRICS_BEARER_TOKEN=
