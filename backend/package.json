{
  "name": "@assetvault/api",
  "version": "1.0.0",
  "description": "AssetVault REST API - Express + Prisma + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../node_modules/ts-node/dist/bin.js src/server.ts",
    "dev:watch": "node ../node_modules/nodemon/bin/nodemon.js --watch src -e ts --exec \"node ../node_modules/ts-node/dist/bin.js src/server.ts\"",
    "worker": "node ../node_modules/ts-node/dist/bin.js src/worker.ts",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node ../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ../node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node ../node_modules/prisma/build/index.js studio",
    "prisma:push": "node ../node_modules/prisma/build/index.js db push",
    "prisma:seed": "node ../node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "lint": "node ../node_modules/typescript/bin/tsc --noEmit",
    "test": "node ../node_modules/vitest/vitest.mjs run",
    "profile": "node ../node_modules/ts-node/dist/bin.js src/profile-assets.ts",
    "benchmark": "node ../node_modules/ts-node/dist/bin.js src/benchmark.ts",
    "check:sqli": "node ../scripts/check-sqli.js",
    "check:secrets": "node ../scripts/scan-secrets.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^5.14.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.2.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
