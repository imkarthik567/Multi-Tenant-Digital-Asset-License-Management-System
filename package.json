{
  "name": "assetvault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AssetVault - Multi-Tenant Digital Asset & License Management System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev --workspace=@assetvault/api\" \"npm run dev --workspace=@assetvault/web\"",
    "dev:api": "npm run dev --workspace=@assetvault/api",
    "dev:web": "npm run dev --workspace=@assetvault/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Karthikeyan S",
  "license": "UNLICENSED"
}
