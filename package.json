{
  "name": "assetvault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AssetVault - Multi-Tenant Digital Asset & License Management System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev --workspace=@assetvault/api\" \"npm run dev --workspace=@assetvault/web\"",
    "dev:api": "npm run dev --workspace=@assetvault/api",
    "dev:web": "npm run dev --workspace=@assetvault/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run prisma:migrate --workspace=@assetvault/api",
    "db:seed": "npm run prisma:seed --workspace=@assetvault/api",
    "db:studio": "npm run prisma:studio --workspace=@assetvault/api",
    "check:sqli": "node scripts/check-sqli.js",
    "check:secrets": "node scripts/scan-secrets.js"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "author": "Karthikeyan S",
  "license": "UNLICENSED"
}
