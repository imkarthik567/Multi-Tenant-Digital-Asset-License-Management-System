{
  "name": "assetvault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AssetVault - Multi-Tenant Digital Asset & License Management System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node node_modules/nodemon/bin/nodemon.js --watch apps/api/src -e ts --exec \"node node_modules/ts-node/dist/bin.js apps/api/src/server.ts\"",
    "dev:web": "node node_modules/vite/bin/vite.js apps/web",
    "build": "node node_modules/typescript/bin/tsc -p apps/api/tsconfig.json && node node_modules/vite/bin/vite.js build apps/web",
    "lint": "node node_modules/typescript/bin/tsc -p apps/api/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --config apps/api/vitest.config.ts",
    "db:push": "node node_modules/prisma/build/index.js db push --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev --schema apps/api/prisma/schema.prisma",
    "db:seed": "node node_modules/ts-node/dist/bin.js apps/api/prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio --schema apps/api/prisma/schema.prisma",
    "db:backup": "node scripts/db-backup-runner.js backup",
    "db:restore": "node scripts/db-backup-runner.js restore",
    "db:verify-restore": "node scripts/db-backup-runner.js verify-restore",
    "check:sqli": "node scripts/check-sqli.js",
    "check:secrets": "node scripts/scan-secrets.js",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.2.5"
  },
  "author": "Karthikeyan S",
  "license": "UNLICENSED"
}
