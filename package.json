{
  "name": "assetvault-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AssetVault - Multi-Tenant Digital Asset & License Management System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node node_modules/nodemon/bin/nodemon.js --watch backend/src -e ts --exec \"node node_modules/ts-node/dist/bin.js backend/src/server.ts\"",
    "dev:web": "node node_modules/vite/bin/vite.js frontend",
    "build": "node node_modules/typescript/bin/tsc -p backend/tsconfig.json && node node_modules/vite/bin/vite.js build frontend",
    "lint": "node node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p frontend/tsconfig.json --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run --config backend/vitest.config.ts",
    "db:push": "node node_modules/prisma/build/index.js db push --schema backend/prisma/schema.prisma",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev --schema backend/prisma/schema.prisma",
    "db:seed": "node node_modules/ts-node/dist/bin.js backend/prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio --schema backend/prisma/schema.prisma",
    "db:backup": "node scripts/db-backup-runner.js backup",
    "db:restore": "node scripts/db-backup-runner.js restore",
    "db:verify-restore": "node scripts/db-backup-runner.js verify-restore",
    "check:sqli": "node scripts/check-sqli.js",
    "check:secrets": "node scripts/scan-secrets.js",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.2.5"
  },
  "author": "Karthikeyan S",
  "license": "UNLICENSED",
  "prisma": {
    "seed": "node node_modules/ts-node/dist/bin.js backend/prisma/seed.ts"
  },
  "overrides": {
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.0",
    "vite": "^6.4.3",
    "uuid": "^11.1.1",
    "hyperid": {
      "uuid": "^11.1.1"
    },
    "react-router": "^7.18.0",
    "react-router-dom": "^7.18.0"
  }
}
