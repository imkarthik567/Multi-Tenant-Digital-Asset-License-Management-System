# ==============================================================================
# AssetVault - Environment Configuration Template (Root)
# Maintain placeholder values only. DO NOT commit actual secrets.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 16) for local non-Docker development
# Runtime API URL uses the restricted app role; its password must match APP_DB_PASSWORD.
DATABASE_URL=postgresql://assetvault_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@localhost:5432/assetvault_db?schema=public
# Direct URL is for Prisma migrations, bootstrap, and trusted maintenance; omit Prisma-only query params.
DIRECT_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@localhost:5432/assetvault_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=assetvault_db
APP_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Set these before running Prisma seed scripts. No default credentials are provided.
SUPER_ADMIN_EMAIL=superadmin@your-local-domain.test
SUPER_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_SUPER_ADMIN_PASSWORD
DEFAULT_SEED_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
PGADMIN_PASSWORD=REPLACE_WITH_LOCAL_PGADMIN_PASSWORD
GRAFANA_PASSWORD=REPLACE_WITH_LOCAL_GRAFANA_PASSWORD

# Required for Docker Compose. Use URL-encoded passwords in the connection URLs.
DOCKER_DATABASE_URL=postgresql://assetvault_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@db:5432/assetvault_db?schema=public
DOCKER_DIRECT_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@db:5432/assetvault_db

# JSON Web Token Configuration (Secrets must be random strings >= 32 chars)
JWT_ACCESS_SECRET=placeholder_random_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=placeholder_random_jwt_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=placeholder_random_cookie_secret_min_32_characters
# Local dev frontend/API use localhost; use strict locally. Hosted cross-site deploy needs none + HTTPS.
COOKIE_SAMESITE=strict

# Google OAuth 2.0 Credentials (Passport.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Client and CORS Settings
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Metrics endpoint: optional in local development; required as a unique secret in production
# METRICS_BEARER_TOKEN=
