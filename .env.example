# ==============================================================================
# AssetVault - Environment Configuration Template (Root)
# Maintain placeholder values only. DO NOT commit actual secrets.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
# Local dev and Docker compose use the same connection string for DATABASE_URL and DIRECT_URL.
# For Supabase / cloud connection pooling (e.g. Render deploys), DATABASE_URL uses the transaction pooler
# (port 6543 with ?pgbouncer=true), and DIRECT_URL connects directly to PostgreSQL (port 5432) for migrations.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/assetvault_db?schema=public
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/assetvault_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=assetvault_db

# JSON Web Token Configuration (Secrets must be random strings >= 32 chars)
JWT_ACCESS_SECRET=placeholder_random_jwt_access_secret_min_32_characters
JWT_REFRESH_SECRET=placeholder_random_jwt_refresh_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=placeholder_random_cookie_secret_min_32_characters

# Google OAuth 2.0 Credentials (Passport.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Client and CORS Settings
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Metrics endpoint: optional in local development; required as a unique secret in production
# METRICS_BEARER_TOKEN=

# Background Worker Execution (authoritative flag)
# Defaults to false so the API service does not run background cron jobs when a dedicated worker exists.
# In multi-container setups (docker-compose), keep false on API and true on Worker to prevent duplicate job runs.
# In single-container deployments (e.g. Render Web Service without separate worker), set to true.
ENABLE_IN_PROCESS_WORKER=false

