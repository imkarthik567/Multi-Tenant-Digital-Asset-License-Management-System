# ==============================================================================
# AssetVault - Environment Configuration Template
# Maintain placeholder values only. DO NOT commit actual secrets.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assetvault_db?schema=public

# JSON Web Token Configuration
# Secrets MUST be random strings of at least 32 characters
JWT_ACCESS_SECRET=change_this_to_a_secure_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_a_secure_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change_this_to_a_secure_cookie_secret_at_least_32_characters

# Google OAuth 2.0 Credentials (Passport.js)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Client and CORS Settings
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (express-rate-limit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=52428800
